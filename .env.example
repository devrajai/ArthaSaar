# Copy to .env for local runs. NEVER commit the real file.
# These are only needed for the optional sync_google.py step.

# Service-account JSON, either inline (one line) or as a file path.
# GOOGLE_SA_JSON={"type":"service_account", ...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Google Drive folder id to mirror the archive into (from the folder URL).
DRIVE_FOLDER_ID=

# The Google Sheet id (from .../spreadsheets/d/<THIS>/edit).
SHEET_ID=

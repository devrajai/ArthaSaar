# secrets - never commit
.env
service-account*.json
*credentials*.json

# keep the repo small - raw bhavcopy zips stay local only; parquet + csv are committed
data/raw/

# per-run heartbeat from the hourly YouTube poll - churns every hour, not worth tracking
data/youtube/last_run.json

# ArthaSaar data is pulled fresh from its source repo each run.
# fii-history.json is the one we accumulate ourselves, so it IS tracked.
data/*.json
!data/fii-history.json
# FM3 forecasts are the model's output, written by .github/workflows/timesfm.yml and
# read by the website - they must be committed, so exempt them from the rule above.
!data/timesfm_forecasts.json

# candle archive + training sets are large - regenerate from Drive, don't commit
data/candles/
data/training/

# mfapi cache: 1,094 per-scheme NAV files + a 12 MB scheme list, re-downloaded every run.
# It was never ignored and had grown to 169 MB - 77% of the repo - to produce a 198 KB
# docs/mf.json. Same class of file as the caches below, so it belongs here too.
data/mf/

# F&O csv is the intermediate step; the parquet is what is read. ~3.5 MB per day adds up
# to roughly 900 MB a year if it is all kept.
data/csv/fo/

# other free-source pulls (regenerate, don't commit)
data/yahoo/
data/sheets/
data/notion/
data/indicators/
data/forecast/
data/crypto/
data/nse/
data/amfi/
data/news/
data/quality/
data/screens/
data/patterns/
data/rs/
data/backtest/

# python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

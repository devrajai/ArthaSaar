nance Limited is a subsidiary of Bajaj Finserv Ltd.","officers":[{"name":"Mr. Rajeev A. Jain","title":"MD & Executive Vice Chairman","age":55,"pay":155574373},{"name":"Mr. Sandeep Vijay Kumar Jain","title":"CFO & COO","age":null,"pay":93163474},{"name":"Mr. Ramachandran  Vijay","title":"Company Secretary & Compliance Officer","age":null,"pay":22391896},{"name":"Mr. Deepak  Bagati","title":"Chief Operating Officer","age":null,"pay":null},{"name":"Mr. Anurag  Chottani","title":"CTO & COO","age":null,"pay":null},{"name":"Mr. Prashant  Verma","title":"Chief Information & Security Officer","age":null,"pay":null},{"name":"Ms. Jennifer Mathew Fernandes","title":"Chief Human Resources & Administration Officer","age":null,"pay":null},{"name":"Mr. Neelesh  Sarda","title":"Chief Compliance Officer","age":null,"pay":null}]}}